{
  "name": "linkbook",
  "version": "0.1.0",
  "productName": "LinkBook",
  "description": "Desktop bookmark manager: save, organize, and browse bookmarks on a board, grid, table, or list.",
  "author": {
    "name": "LinkBook",
    "email": "SYZADMIN666@proton.me"
  },
  "license": "MIT",
  "main": ".vite/build/main.cjs",
  "desktopName": "linkbook.desktop",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "umask 022 && electron-forge make",
    "make:deb": "umask 022 && electron-forge make --targets deb",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests forge.config.ts vite.main.config.ts vite.preload.config.ts vite.renderer.config.ts vitest.config.mts vitest.e2e.config.mts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@duo-icons/react": "^1.0.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "44.5.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "20.14.5",
    "next": "16.4.2",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
